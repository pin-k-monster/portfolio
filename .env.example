# SMTP settings for the contact form (app/api/contact -> nodemailer).
# Copy this file to `.env.local` and fill in the values.
# Gmail example: SMTP_HOST=smtp.gmail.com with an App Password
# (a normal password will not work - create one at https://myaccount.google.com/apppasswords).

# SMTP server hostname
SMTP_HOST=smtp.example.com
# SMTP port (587 for STARTTLS, 465 for implicit SSL)
SMTP_PORT=587
# Set to true for the implicit-SSL port; usually false for 587
SMTP_SECURE=false

# SMTP credentials
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# Inbox that receives submissions. Falls back to SMTP_USER when empty.
CONTACT_TO=you@example.com
